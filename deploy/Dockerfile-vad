
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    VAD_MODEL_PATH=/app/pretrained_models/FireRedVAD/VAD

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    git \
    ffmpeg \
    libsndfile1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

RUN python -m pip install --upgrade pip setuptools wheel

COPY ./requirements/requirements-vad.txt /app/requirements-vad.txt

RUN python -m pip install -r /app/requirements-vad.txt

# Copy the project from the root build context.
COPY . /app

# Download the pretrained FireRedVAD model.
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download(repo_id='FireRedTeam/FireRedVAD', local_dir='/app/pretrained_models/FireRedVAD')"

CMD ["serve", "run", "task.vad_consumer:app"]
