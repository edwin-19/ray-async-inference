
ARG VLLM_TAG=v0.14.0
FROM vllm/vllm-openai:${VLLM_TAG}

# Install uv without replacing the base image's Python/PyTorch stack
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/root/.cache/huggingface

# Audio runtime libraries and build dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ffmpeg \
        git \
        curl \
        libsndfile1 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install ASR and pipeline dependencies
COPY requirements/requirements-asr.txt /requirements-asr.txt

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages \
        -r /requirements-asr.txt

# Copy Ray Serve consumer and supporting modules
COPY . /app

# Verify core runtime imports and CUDA visibility
RUN python3 -c "import torch; import vllm; print('PyTorch:', torch.__version__); print('vLLM:', vllm.__version__); print('CUDA available:', torch.cuda.is_available())"

# Override the base vLLM API-server entrypoint.
# Start this container as a Ray Serve consumer instead.
ENTRYPOINT []

CMD ["serve", "run", "task.asr:app"]
