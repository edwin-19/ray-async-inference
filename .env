# ============================================================
# VAD
# ============================================================

VAD_QUEUE=vad_queue
ASR_QUEUE=asr_queue
VAD_FAILED_QUEUE=vad_failed_queue

VAD_MAX_RETRIES=3
# VAD_MODEL_PATH=/app/pretrained_models/FireRedVAD

# Change vad settings
AUDIO_01_MAX_ONGOING_REQUESTS=2
AUDIO_01_NUM_CPUS=2
AUDIO_01_USE_GPU=false
AUDIO_01_MIN_REPLICAS=3
AUDIO_01_MAX_REPLICAS=3
AUDIO_01_TARGET_ONGOING_REQUESTS=3


# ============================================================
# ASR
# ============================================================
ASR_QUEUE=asr_queue
ALIGN_QUEUE=align_queue
ASR_FAILED_QUEUE=asr_failed_queue

SPECULATOR_MODEL=mattymchen/Qwen3-ASR-1.7B-speculator.dflash2
ASR_MODEL_NAME=Qwen/Qwen3-ASR-1.7B-hf
ASR_LANGUAGE=

ASR_MAX_RETRIES=3

AUDIO_02_BATCH_SIZE=1
AUDIO_02_ATTENTION_BACKEND=FLASH_ATTN
AUDIO_02_NUM_GPUS_PER_REPLICA=1
AUDIO_02_NUM_CPUS_PER_REPLICA=2
AUDIO_02_GPU_MEMORY_UTILIZATION=0.6
AUDIO_02_MAX_MODEL_LEN=3000
AUDIO_02_MAX_NEW_TOKENS=512
AUDIO_02_MIN_REPLICAS=1
AUDIO_02_MAX_REPLICAS=1
AUDIO_02_TARGET_ONGOING_REQUESTS=1


# ============================================================
# ALIGN
# ============================================================
ALIGN_QUEUE=align_queue
ALIGN_FAILED_QUEUE=align_failed_queue

ALIGN_MODEL_NAME=Qwen/Qwen3-ForcedAligner-0.6B-hf

ALIGN_MAX_RETRIES=3
ALIGN_DEVICE=auto

ALIGN_COMPILE=false
ALIGN_COMPILE_BACKEND=inductor
ALIGN_COMPILE_FULLGRAPH=false
ALIGN_COMPILE_DYNAMIC=false

AUDIO_03_BATCH_SIZE=1
AUDIO_03_MIN_REPLICAS=2
AUDIO_03_MAX_REPLICAS=2
AUDIO_03_NUM_GPUS_PER_REPLICA=0.5
AUDIO_03_NUM_CPUS_PER_REPLICA=2
AUDIO_03_TARGET_ONGOING_REQUESTS=2
